    "date picker",
    "date range picker",
    "dialog",
    "divider",
    "field",
    "iconbutton",
    "layout",
    "list",
    "menu",
    "navigation bar",
    "navigation rail",
    "progress indicator",
    "radio button",
    "select",
    "shapes",
    "sidesheet",
    "slider",
    "snackbar",
    "stepper",
    "switch",
    "textfield",
    "time picker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/henkpb/micl"
  },
  "homepage": "https://github.com/henkpb/micl",
  "bugs": {
    "url": "https://github.com/henkpb/micl/issues"
  },
  "main": "dist/micl.js",
  "types": "dist/micl.d.ts",
  "files": [
    "dist",
    "styles.scss",
    "styles/**/*.scss",
    "foundations/**/*.scss",
    "components/**/*.scss",
    "components/**/README.md",
    "themes"
