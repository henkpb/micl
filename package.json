    "glob": "^13.0",
    "mini-css-extract-plugin": "^2.10",
    "postcss-loader": "^8.2",
    "sass": "^1.101",
    "sass-loader": "^17.0",
    "ts-loader": "^9.6",
    "typescript": "^6.0",
    "webpack": "^5.108",
    "webpack-cli": "^7.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
